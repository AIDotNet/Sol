{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "ConnectionString": "",
    "RunMigrationsOnStartup": false
  },
  "Redis": {
    "Configuration": "",
    "InstanceName": "sol:"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "sol",
    "Password": "",
    "VirtualHost": "/",
    "Exchange": "sol.events",
    "QueueName": "sol.events.api",
    "PrefetchCount": 16,
    "RoutingKeys": [ "device.#" ]
  },
  "Realtime": {
    "Backplane": "None"
  },
  "DeviceIdentity": {
    "SignalVersion": 1,
    "CoarseWindowHours": 24,
    "MaxCoarseFanout": 5,
    "CookieName": "sol_did",
    "CookieMaxAgeDays": 730
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
