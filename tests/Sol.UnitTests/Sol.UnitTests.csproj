<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Directory.Build.props turns the trim/AOT analysers on for every project. Tests are never
      published as a native binary and xunit discovers them reflectively, so leaving it on would
      report violations that cannot be acted on.
    -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sol.Domain/Sol.Domain.csproj" />
    <ProjectReference Include="../../src/Sol.Infrastructure/Sol.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- ImplicitUsings is on solution-wide, so Xunit joins the same set. -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
